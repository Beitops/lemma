# Local Edge Function configuration. Copy this file to `.env`; never commit `.env`.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# The local Edge runtime reaches Supabase through an internal Docker URL, while
# browser JWTs use the public local URL as their issuer.
LEMMA_AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
