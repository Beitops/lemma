# Browser-safe Supabase configuration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional browser override. By default the Edge API URL is derived from
# VITE_SUPABASE_URL as /functions/v1/lemma-api/api/v1.
# VITE_API_URL=https://your-project.supabase.co/functions/v1/lemma-api/api/v1

# Edge Function CORS allowlist. Supabase injects SUPABASE_URL and
# SUPABASE_ANON_KEY in its runtime; neither needs to be exposed through Vite.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
